---
import ClaiireIcon from './ClaiireIcon.astro';

interface Props {
  parcourId: string;
  modules: Array<{ title: string; link: string }>;
}

const { parcourId, modules } = Astro.props;
---

<div class="parcour-progress-widget" data-parcour-id={parcourId}>
  <div class="progress-header">
    <h3>Ta progression</h3>
    <span class="progress-percentage">0%</span>
  </div>

  <div
    class="progress-bar"
    role="progressbar"
    aria-label="Progression du parcours"
    aria-valuemin="0"
    aria-valuemax={modules.length}
    aria-valuenow="0"
  >
    <div class="progress-fill"></div>
  </div>

  <ul class="module-list">
    {modules.map((module, index) => (
      <li class="module-item" data-module-index={index}>
        <input
          type="checkbox"
          id={`module-${parcourId}-${index}`}
          class="module-checkbox"
        />
        <label for={`module-${parcourId}-${index}`}>
          <span class="checkbox-custom"></span>
          <span class="module-title">{module.title}</span>
        </label>
        <a href={module.link} class="module-arrow" aria-label={`Accéder à ${module.title}`}>
          <ClaiireIcon name="arrowRight" size="var(--site-icon-sm)" />
        </a>
      </li>
    ))}
  </ul>

  <button class="reset-progress">Réinitialiser la progression</button>
</div>

<script>
  import { initParcourTracker } from '../scripts/parcours-tracker.js';

  document.addEventListener('DOMContentLoaded', () => {
    initParcourTracker();
  });
</script>

<style>
  .parcour-progress-widget {
    background: linear-gradient(180deg, var(--site-surface-strong) 0%, var(--site-surface-muted) 100%);
    border: 1px solid var(--site-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    padding: var(--site-space-6);
    margin: 0;
  }

  .progress-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--site-space-4);
  }

  .progress-header h3 {
    margin: 0;
    font-size: var(--site-font-lg);
  }

  .progress-percentage {
    font-size: var(--site-font-1p5);
    font-weight: bold;
    color: var(--sl-color-accent);
    padding: var(--site-space-0p2) var(--site-space-0p75);
    border-radius: var(--site-radius-pill);
    background: var(--site-accent-soft);
  }

  .progress-bar {
    height: var(--site-size-8px);
    background: var(--sl-color-gray-5);
    border-radius: var(--site-radius-pill);
    overflow: hidden;
    margin-bottom: var(--site-space-6);
  }

  .progress-fill {
    width: var(--site-size-0pct);
    height: var(--site-size-100pct);
    background: linear-gradient(90deg, var(--site-highlight) 0%, var(--sl-color-accent) 100%);
    border-radius: inherit;
    transition: width var(--site-motion-slow) var(--site-ease-standard);
  }

  .module-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .module-item {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--site-space-3);
    margin-bottom: var(--site-space-3);
    padding: var(--site-space-0p9) var(--site-space-4);
    border: 1px solid var(--site-border);
    border-radius: var(--site-radius-0p9);
    background: var(--site-surface);
    overflow: hidden;
    transition:
      transform var(--site-motion-0p18) var(--site-ease-standard),
      border-color var(--site-motion-0p18) var(--site-ease-standard),
      box-shadow var(--site-motion-0p18) var(--site-ease-standard),
      background-color var(--site-motion-0p18) var(--site-ease-standard);
  }

  .module-item::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--site-space-0p3);
    background: linear-gradient(180deg, var(--site-highlight) 0%, var(--sl-color-accent) 100%);
    opacity: 0.15;
    transition: opacity var(--site-motion-0p18) var(--site-ease-standard);
  }

  .module-item:hover {
    border-color: var(--site-accent);
    box-shadow: var(--shadow-soft);
    transform: translateY(-1px);
  }

  .module-item:hover::before {
    opacity: 0.4;
  }

  .module-item[data-complete='true'] {
    border-color: var(--site-accent);
    background: linear-gradient(180deg, var(--site-accent-soft) 0%, var(--site-surface-strong) 100%);
    box-shadow: var(--shadow-soft);
  }

  .module-item[data-complete='true']::before {
    opacity: 1;
  }

  .module-item label {
    display: flex;
    align-items: center;
    gap: var(--site-space-3);
    flex: 1;
    min-width: 0;
    cursor: pointer;
    min-height: var(--site-control-min-height);
  }

  .module-checkbox {
    position: absolute;
    opacity: 0;
    width: var(--site-size-20px);
    height: var(--site-size-20px);
    cursor: pointer;
  }

  .module-checkbox:focus-visible + label .checkbox-custom {
    outline: var(--site-size-3px) solid var(--site-focus-ring);
    outline-offset: var(--site-space-2);
  }

  .checkbox-custom {
    width: var(--site-space-1p35);
    height: var(--site-space-1p35);
    border: var(--site-size-2px) solid var(--sl-color-gray-4);
    border-radius: var(--site-radius-0p45);
    position: relative;
    flex-shrink: 0;
    background: linear-gradient(180deg, var(--site-surface-strong) 0%, var(--site-surface-muted) 100%);
    box-shadow: inset 0 1px 0 var(--site-shadow-white-08);
    transition:
      transform var(--site-motion-0p18) var(--site-ease-standard),
      background-color var(--site-motion-0p18) var(--site-ease-standard),
      border-color var(--site-motion-0p18) var(--site-ease-standard),
      box-shadow var(--site-motion-0p18) var(--site-ease-standard);
  }

  .module-item:hover .checkbox-custom {
    border-color: var(--site-accent);
    box-shadow:
      inset 0 1px 0 var(--site-shadow-white-08),
      var(--shadow-soft);
    transform: translateY(-1px);
  }

  .module-checkbox:checked + label .checkbox-custom {
    background: linear-gradient(180deg, var(--site-highlight) 0%, var(--sl-color-accent) 100%);
    border-color: var(--sl-color-accent);
    box-shadow: var(--site-primary-shadow);
    transform: scale(1.04);
    animation: checkbox-pop var(--site-motion-0p24) var(--site-ease-standard);
  }

  .module-checkbox:checked + label .checkbox-custom::after {
    content: '';
    position: absolute;
    width: var(--site-space-0p34);
    height: var(--site-space-0p68);
    border-right: var(--site-size-2px) solid white;
    border-bottom: var(--site-size-2px) solid white;
    top: var(--site-size-45pct);
    left: var(--site-size-50pct);
    transform: translate(-50%, -58%) rotate(45deg);
  }

  .module-checkbox:checked + label .module-title {
    text-decoration: line-through;
    opacity: 0.6;
  }

  .module-title {
    font-weight: 600;
    transition: color var(--site-motion-0p18) var(--site-ease-standard);
  }

  .module-item[data-complete='true'] .module-title {
    color: var(--site-accent-strong);
  }

  .module-arrow {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--site-control-min-height);
    min-height: var(--site-control-min-height);
    border-radius: var(--site-radius-pill);
    color: var(--sl-color-gray-3);
    transition:
      color var(--site-motion-0p2) var(--site-ease-standard),
      transform var(--site-motion-0p2) var(--site-ease-standard);
  }

  .module-arrow:hover {
    color: var(--sl-color-accent);
    transform: translateX(2px);
  }

  .module-item[data-complete='true'] .module-arrow {
    color: var(--sl-color-accent);
  }

  .reset-progress {
    margin-top: var(--site-space-4);
    padding: var(--site-space-0p65) var(--site-space-4);
    background: var(--site-surface);
    border: 1px solid var(--sl-color-gray-4);
    border-radius: var(--site-radius-999);
    cursor: pointer;
    min-height: var(--site-control-min-height);
    font-size: var(--site-font-0p875);
    color: var(--sl-color-text);
    transition:
      background-color var(--site-motion-0p2) var(--site-ease-standard),
      border-color var(--site-motion-0p2) var(--site-ease-standard),
      transform var(--site-motion-0p2) var(--site-ease-standard);
  }

  .reset-progress:hover {
    background: var(--sl-color-gray-5);
    transform: translateY(-1px);
  }

  @media (max-width: 45rem) {
    .parcour-progress-widget {
      padding: var(--site-space-5);
      margin-inline: calc(-1 * var(--site-space-0p2));
    }

    .module-item {
      align-items: flex-start;
      padding: var(--site-space-0p75) var(--site-space-3);
    }

    .module-arrow {
      margin-top: var(--site-space-0p2);
    }

    .reset-progress {
      width: var(--site-size-100pct);
    }
  }

  @keyframes checkbox-pop {
    0% {
      transform: scale(0.9);
    }

    70% {
      transform: scale(1.08);
    }

    100% {
      transform: scale(1.04);
    }
  }
</style>
