---
import ClaiireIcon from './ClaiireIcon.astro';

interface Props {
  id: string;
  title: string;
  icon: string;
  description: string;
  color: string;
  moduleCount: number;
}

const { id, title, icon, description, color, moduleCount } = Astro.props;
---

<a href={`/parcours/${id}`} class="parcour-card" data-parcour-id={id} data-module-count={moduleCount} style={`--parcour-color: ${color}`}>
  <div class="parcour-card-inner">
    <div class="parcour-header">
      <div class="parcour-title-row">
        <div class="parcour-icon-wrapper">
          <span class="parcour-icon"><ClaiireIcon name={icon} size="var(--site-icon-base)" /></span>
        </div>
        <h3>{title}</h3>
      </div>
      <div class="parcour-module-badge">
        <ClaiireIcon name="book" size="var(--site-icon-xs)" />
        <span>{moduleCount} paliers</span>
      </div>
    </div>
    <div class="parcour-content">
      <p>{description}</p>
    </div>
    <div class="parcour-footer">
      <div
        class="parcour-progress-mini"
        role="progressbar"
        aria-label={`Avancement de lecture du chemin ${title}`}
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
      >
        <div class="progress-bar-bg">
          <div class="progress-bar-fill"></div>
        </div>
        <span class="progress-text">0%</span>
      </div>
      <span class="parcour-cta">
        Entrer dans ce chemin
        <ClaiireIcon name="arrowRight" size="var(--site-icon-xs)" />
      </span>
    </div>
  </div>
</a>

<style>
  .parcour-card {
    display: block;
    text-decoration: none;
    color: inherit;
    height: var(--site-size-100pct);
    background: var(--site-parcours-card-surface);
    border: var(--site-parcours-card-border-width) solid var(--site-parcours-card-border);
    border-radius: var(--site-parcours-card-radius);
    padding: var(--site-parcours-card-padding);
    transition: transform var(--site-motion-standard) var(--site-ease-emphasis),
                box-shadow var(--site-motion-standard) var(--site-ease-emphasis),
                border-color var(--site-motion-standard) var(--site-ease-standard);
    position: relative;
    overflow: hidden;
  }

  .parcour-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: var(--site-size-3px);
    background: var(--site-parcours-card-accent-gradient);
    opacity: var(--site-parcours-card-accent-opacity);
    transition: opacity var(--site-motion-0p24) var(--site-ease-standard);
  }

  .parcour-card:hover {
    transform: translateY(calc(-1 * var(--site-size-6px)));
    box-shadow: var(--site-parcours-card-shadow-hover);
    border-color: var(--parcour-color);
  }

  .parcour-card:focus-visible {
    border-color: var(--parcour-color);
    box-shadow: var(--site-parcours-card-shadow-hover);
  }

  .parcour-card:hover::before {
    opacity: var(--site-parcours-card-accent-opacity-active);
  }

  .parcour-card-inner {
    display: flex;
    flex-direction: column;
    height: var(--site-size-100pct);
    gap: var(--site-space-4);
  }

  .parcour-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--site-space-3);
  }

  .parcour-title-row {
    display: flex;
    align-items: center;
    gap: var(--site-space-3);
    flex: 1;
    min-width: 0;
  }

  .parcour-card h3 {
    margin: 0;
    font-size: var(--site-font-1p05);
    font-weight: 700;
    color: var(--site-text);
    line-height: var(--site-leading-1);
  }

  .parcour-icon-wrapper {
    width: var(--site-parcours-icon-size);
    height: var(--site-parcours-icon-size);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--site-parcours-icon-radius);
    background: var(--site-parcours-icon-surface);
    flex-shrink: 0;
    transition:
      transform var(--site-motion-standard) var(--site-ease-emphasis),
      background var(--site-motion-standard) var(--site-ease-standard);
  }

  .parcour-card:hover .parcour-icon-wrapper {
    transform: scale(var(--site-parcours-icon-scale-active));
    background: var(--site-parcours-icon-surface-active);
  }

  .parcour-icon {
    font-size: var(--site-font-1p4);
    line-height: var(--site-leading-1);
  }

  .parcour-module-badge {
    display: flex;
    align-items: center;
    gap: var(--site-space-0p35);
    font-size: var(--site-parcours-meta-size);
    font-weight: 500;
    color: var(--site-neutral-300);
    background: var(--site-parcours-meta-surface);
    padding: var(--site-space-0p3) var(--site-space-0p6);
    border-radius: var(--site-parcours-meta-radius);
    min-height: var(--site-control-min-height);
  }

  .parcour-module-badge svg {
    opacity: 0.7;
  }

  .parcour-content {
    flex: 1;
  }

  .parcour-card p {
    margin: 0;
    color: var(--site-neutral-200);
    font-size: var(--site-parcours-body-size);
    line-height: var(--site-leading-1p55);
  }

  .parcour-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--site-space-0p75);
    border-top: var(--site-parcours-card-border-width) solid var(--site-parcours-separator);
    gap: var(--site-space-4);
  }

  .parcour-progress-mini {
    display: flex;
    align-items: center;
    gap: var(--site-space-2);
    flex: 1;
  }

  .progress-bar-bg {
    flex: 1;
    height: var(--site-parcours-progress-height);
    background: var(--site-parcours-progress-track);
    border-radius: var(--site-parcours-progress-radius);
    overflow: hidden;
    max-width: var(--site-parcours-progress-width);
  }

  .progress-bar-fill {
    height: var(--site-size-100pct);
    width: var(--site-size-0pct);
    background: var(--parcour-color);
    border-radius: var(--site-parcours-progress-radius);
    transition: width var(--site-motion-0p4) var(--site-ease-standard);
  }

  .progress-text {
    font-size: var(--site-parcours-meta-size);
    font-weight: 600;
    color: var(--site-neutral-300);
    min-width: var(--site-parcours-percent-width);
  }

  .parcour-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--site-space-0p4);
    min-height: var(--site-control-min-height);
    font-size: var(--site-parcours-cta-size);
    font-weight: 600;
    color: var(--parcour-color);
    transition: gap var(--site-motion-0p2) var(--site-ease-standard);
    white-space: nowrap;
  }

  .parcour-card:hover .parcour-cta {
    gap: var(--site-space-0p6);
  }

  @media (max-width: 45rem) {
    .parcour-card {
      padding: var(--site-parcours-card-padding-compact);
    }

    .parcour-module-badge {
      padding-inline: var(--site-space-0p75);
    }

    .parcour-header {
      flex-wrap: wrap;
    }

    .parcour-footer {
      align-items: center;
    }

    .progress-bar-bg {
      max-width: var(--site-parcours-progress-width-compact);
    }

    .parcour-progress-mini {
      width: 100%;
    }
  }
</style>
