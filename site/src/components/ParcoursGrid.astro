---
import ParcourCard from './ParcourCard.astro';
import { parcours } from '../config/parcours.js';
---

{parcours.length > 0 && (
  <ul class="parcours-grid" aria-label="Parcours santé et bien-être">
    {parcours.map(p => (
      <li class="parcours-grid__item">
        <ParcourCard
          id={p.id}
          title={p.title}
          icon={p.icon}
          description={p.description}
          color={p.color}
          moduleCount={p.modules.length}
        />
      </li>
    ))}
  </ul>
)}

<script>
  import { initParcourTracker } from '../scripts/parcours-tracker.js';

  document.addEventListener('DOMContentLoaded', () => {
    initParcourTracker();
  });
</script>
