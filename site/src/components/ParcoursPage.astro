---
import ParcourProgress from './ParcourProgress.astro';
import StaticPageLayout from '../layouts/StaticPageLayout.astro';

interface LinkItem {
  href: string;
  text: string;
}

interface StepItem {
  title: string;
  body: string;
  links: LinkItem[];
}

interface Props {
  currentPath: string;
  title: string;
  description: string;
  hero: {
    title: string;
    tagline?: string;
    actions?: Array<{ text: string; link: string; variant?: 'primary' | 'secondary' | 'minimal' }>;
  };
  parcourId: string;
  modules: Array<{ title: string; link: string }>;
  intro: string;
  steps: StepItem[];
  resources: LinkItem[];
  closing: string;
}

const { currentPath, title, description, hero, parcourId, modules, intro, steps, resources, closing } = Astro.props;
---

<StaticPageLayout
  currentPath={currentPath}
  title={title}
  description={description}
  hero={hero}
  sectionLabel="Parcours thématiques"
  articleClass="prose--parcours"
>
  <div class="parcours-layout">
    <aside class="parcours-layout__rail" aria-label="Progression du parcours">
      <ParcourProgress parcourId={parcourId} modules={modules} />
    </aside>

    <div class="parcours-layout__content">
      <p>
        <strong>{intro}</strong>
      </p>

      <hr />

      {steps.map((step) => (
        <>
          <h2>{step.title}</h2>
          <p>{step.body}</p>
          {step.links.map((link) => (
            <p class="parcours-step-link">
              → <a href={link.href}>{link.text}</a>
            </p>
          ))}
          <hr />
        </>
      ))}

      <h2>Pour aller plus loin</h2>
      <ul>
        {resources.map((resource) => (
          <li>
            <a href={resource.href}>{resource.text}</a>
          </li>
        ))}
      </ul>

      <hr />

      <p>
        <strong>{closing}</strong>
      </p>
    </div>
  </div>
</StaticPageLayout>

<style>
  .parcours-step-link a {
    display: inline-flex;
    align-items: center;
    min-height: var(--site-control-min-height);
    font-weight: 700;
  }

  .parcours-layout {
    display: grid;
    gap: var(--site-parcours-layout-gap);
  }

  .parcours-layout__content {
    max-width: var(--site-content-parcours-reading);
  }

  @media (min-width: 60.0625rem) {
    .parcours-layout {
      grid-template-columns: minmax(var(--site-parcours-rail-min), var(--site-parcours-rail-max)) minmax(0, 1fr);
      align-items: start;
    }

    .parcours-layout__rail {
      position: sticky;
      top: var(--site-sticky-offset);
    }
  }

  @media (max-width: 45rem) {
    .parcours-step-link {
      margin-block: var(--site-space-3);
    }
  }
</style>
