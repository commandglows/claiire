---
import { SignIn } from '@clerk/astro/components';
import StaticPageLayout from '../layouts/StaticPageLayout.astro';

const isClerkEnabled = Boolean(import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY);
const authState = Astro.locals.auth?.();
const redirectUrl = Astro.url.searchParams.get('redirect_url') || '/compte/';

if (authState?.userId) {
  return Astro.redirect('/compte/');
}
---

<StaticPageLayout
  currentPath="/connexion/"
  title="Connexion Claiire"
  description="La connexion Claiire sert de point d'entree a ta session. Les ressources sont ouvertes et gratuites."
  sectionLabel="Compte"
  articleClass="prose--account"
  hero={{
    title: 'Connexion Claiire',
    tagline:
      isClerkEnabled
        ? 'Connecte-toi ici pour retrouver ta session Claiire. Toutes les ressources restent ouvertes et gratuites.'
        : "Clerk n'est pas encore configure dans cet environnement. Les ressources Claiire restent ouvertes et gratuites.",
    actions: [{ text: 'Revenir aux chemins guidés', link: '/formations/', variant: 'primary' }],
  }}
>
  {isClerkEnabled ? (
    <>
      <p>
        Une fois connecte(e), tu pourras retrouver ta session Claiire et tes réglages. Les ressources sont
        accessibles librement.
      </p>

      <SignIn fallbackRedirectUrl={redirectUrl} signUpUrl="/connexion/" />
    </>
  ) : (
    <>
      <h2>Ce qui est pret</h2>
      <ul>
        <li>route de connexion</li>
        <li>accès à ton compte Claiire</li>
        <li>ressources ouvertes et gratuites</li>
      </ul>

      <h2>Ce qu'il manque encore</h2>
      <p>
        Il faut maintenant renseigner les cles Clerk pour activer le vrai parcours de connexion dans cet
        environnement.
      </p>
    </>
  )}
</StaticPageLayout>
