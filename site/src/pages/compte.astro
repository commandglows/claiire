---
import { UserButton } from '@clerk/astro/components';
import StaticPageLayout from '../layouts/StaticPageLayout.astro';

const isClerkEnabled = Boolean(import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY);
const authState = Astro.locals.auth?.();
const memberSession = Astro.locals.memberSession;

if (isClerkEnabled && !authState?.userId) {
  return Astro.redirect('/connexion/?redirect_url=/compte/');
}
---

<StaticPageLayout
  currentPath="/compte/"
  title="Compte Claiire"
  description="Ton compte Claiire centralise ta session et les liens utiles. Les ressources sont ouvertes et gratuites."
  sectionLabel="Compte"
  articleClass="prose--account"
  hero={{
    title: 'Compte Claiire',
    tagline:
      'Cette page centralise ta session. Les ressources Claiire sont ouvertes et accessibles gratuitement.',
    actions: [{ text: 'Revenir aux chemins guidés', link: '/formations/', variant: 'primary' }],
  }}
>
  <h2>Objectif de cette page</h2>
  <ul>
    <li>retrouver les ressources Claiire, ouvertes et gratuites</li>
    <li>consulter l'etat de ta session</li>
    <li>gérer les réglages de ton compte</li>
  </ul>

  {isClerkEnabled ? (
    <>
      <h2>Etat de la session</h2>
      <ul>
        <li>connecte(e) : {authState?.userId ? 'oui' : 'non'}</li>
        <li>user_id : <code>{memberSession?.userId ?? 'inconnu'}</code></li>
      </ul>

      <h2>Gestion du compte</h2>
      <UserButton />
    </>
  ) : (
    <>
      <h2>Etat actuel</h2>
      <p>
        Les ressources Claiire sont ouvertes et accessibles gratuitement. La connexion permettra simplement
        de retrouver ta session et les réglages de ton compte.
      </p>
    </>
  )}
</StaticPageLayout>
