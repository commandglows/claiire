---
import StaticPageLayout from './StaticPageLayout.astro';

interface ActionLink {
  text: string;
  link: string;
  variant?: 'primary' | 'secondary' | 'minimal';
}

interface BulletItem {
  title?: string;
  body: string;
}

interface ResourceItem {
  label: string;
  detail?: string;
  href?: string;
}

interface Props {
  currentPath: string;
  title: string;
  description: string;
  sectionLabel?: string;
  robots?: 'index, follow' | 'noindex, nofollow';
  heroTitle?: string;
  heroTagline?: string;
  moduleLabel?: string;
  progressLabel?: string;
  backAction?: ActionLink;
  nextAction?: ActionLink;
  recapItems?: BulletItem[];
  checklistItems?: string[];
  protocolItems?: BulletItem[];
  resourceItems?: ResourceItem[];
  warningItems?: string[];
}

const {
  currentPath,
  title,
  description,
  sectionLabel = 'Espace membre',
  robots = 'noindex, nofollow',
  heroTitle = title,
  heroTagline = description,
  moduleLabel = 'Version complète',
  progressLabel,
  backAction,
  nextAction,
  recapItems = [],
  checklistItems = [],
  protocolItems = [],
  resourceItems = [],
  warningItems = [],
} = Astro.props;

const hero = {
  title: heroTitle,
  tagline: heroTagline,
  actions: [backAction, nextAction].filter((action): action is ActionLink => Boolean(action)),
};
---

<StaticPageLayout
  currentPath={currentPath}
  title={title}
  description={description}
  sectionLabel={sectionLabel}
  hero={hero}
  robots={robots}
  articleClass="prose--formation"
>
  <section class="member-shell">
    <header class="member-shell__intro">
      <div>
        <p class="member-shell__eyebrow">{moduleLabel}</p>
        <h2>Version intégrale du module</h2>
      </div>
      {progressLabel && <p class="member-shell__progress">{progressLabel}</p>}
    </header>

    {recapItems.length > 0 && (
      <section class="member-block">
        <h3>Avant de commencer</h3>
        <ul class="member-list">
          {recapItems.map((item) => (
            <li>
              {item.title && <strong>{item.title} — </strong>}
              {item.body}
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="member-block member-block--content">
      <h3>Contenu intégral</h3>
      <div class="member-richtext">
        <slot />
      </div>
    </section>

    {checklistItems.length > 0 && (
      <section class="member-block">
        <h3>Checklist pratique</h3>
        <ul class="member-checklist">
          {checklistItems.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>
    )}

    {protocolItems.length > 0 && (
      <section class="member-block">
        <h3>Protocole</h3>
        <ol class="member-protocol">
          {protocolItems.map((item) => (
            <li>
              {item.title && <strong>{item.title}</strong>}
              <p>{item.body}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    {resourceItems.length > 0 && (
      <section class="member-block member-block--resources">
        <h3>Ressources premium</h3>
        <div class="member-resources">
          {resourceItems.map((item) => (
            item.href ? (
              <a href={item.href}>
                <strong>{item.label}</strong>
                {item.detail && <span>{item.detail}</span>}
              </a>
            ) : (
              <div>
                <strong>{item.label}</strong>
                {item.detail && <span>{item.detail}</span>}
              </div>
            )
          ))}
        </div>
      </section>
    )}

    {warningItems.length > 0 && (
      <section class="member-block member-block--warning">
        <h3>Points de vigilance</h3>
        <ul class="member-list">
          {warningItems.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>
    )}
  </section>
</StaticPageLayout>

<style>
  .member-shell {
    display: grid;
    gap: var(--site-space-6);
    margin: 0 auto;
    max-width: var(--site-width-private);
  }

  .member-shell__intro,
  .member-block {
    background: linear-gradient(180deg, color-mix(in srgb, var(--site-surface-strong) 94%, white 6%), var(--site-surface-strong));
    border: 1px solid var(--site-neutral-500);
    border-radius: var(--radius-lg);
    padding: var(--site-space-6);
    box-shadow: var(--site-formation-surface-shadow);
  }

  .member-shell__intro {
    align-items: center;
    display: flex;
    gap: var(--site-space-4);
    justify-content: space-between;
  }

  .member-shell__eyebrow {
    color: var(--site-accent-strong);
    font-size: var(--site-font-0p8);
    font-weight: 700;
    letter-spacing: var(--site-letter-0p08);
    margin: 0 0 0.4rem;
    text-transform: uppercase;
  }

  .member-shell__intro h2,
  .member-block h3 {
    margin-top: 0;
  }

  .member-richtext,
  .member-shell__intro > div,
  .member-block--content > p {
    max-width: var(--site-content-formation-reading);
  }

  .member-shell__progress {
    background: color-mix(in srgb, var(--site-accent-soft) 70%, white 30%);
    border-radius: var(--site-radius-pill);
    font-size: var(--site-font-0p92);
    margin: 0;
    padding: var(--site-space-0p55) var(--site-space-0p9);
    white-space: nowrap;
  }

  .member-block--content {
    border-color: color-mix(in srgb, var(--site-accent-strong) 35%, var(--site-neutral-500));
  }

  .member-block--warning {
    background: linear-gradient(180deg, color-mix(in srgb, var(--site-highlight-soft) 70%, white 30%), var(--site-surface-strong));
    border-color: color-mix(in srgb, var(--site-highlight) 40%, var(--site-neutral-500));
  }

  .member-list,
  .member-checklist,
  .member-protocol {
    display: grid;
    gap: var(--site-space-0p85);
    margin: 0;
    padding-left: var(--site-space-1p2);
  }

  .member-checklist {
    list-style: '□  ';
  }

  .member-protocol li p {
    margin: var(--site-space-0p35) 0 0;
  }

  .member-resources {
    display: grid;
    gap: var(--site-space-0p85);
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .member-resources a,
  .member-resources div {
    background: color-mix(in srgb, var(--site-surface-strong) 96%, white 4%);
    border: 1px solid var(--site-neutral-500);
    border-radius: var(--radius-md);
    display: grid;
    gap: var(--site-space-0p35);
    padding: var(--site-space-4);
    text-decoration: none;
  }

  .member-resources span {
    color: var(--site-muted);
    font-size: var(--site-font-0p95);
  }

  @media (max-width: 45rem) {
    .member-shell__intro,
    .member-block {
      padding: var(--site-space-5);
      border-radius: var(--radius-md);
    }

    .member-shell__intro {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
